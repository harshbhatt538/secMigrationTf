# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform plan output
*.tfplan
*.plan

# Terraform lock file can be committed to pin provider versions, but it is
# regenerated by terraform init. For a team project, commit .terraform.lock.hcl.
# If you prefer not to, uncomment the next line.
#.terraform.lock.hcl
